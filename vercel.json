{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/lib/:path*", "destination": "/api/not-found" },
    { "source": "/data/:path*", "destination": "/api/not-found" },
    { "source": "/scripts/:path*", "destination": "/api/not-found" },
    { "source": "/tests/:path*", "destination": "/api/not-found" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}

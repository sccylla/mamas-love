# Server-only. Connect Upstash Redis to this project through the Vercel Marketplace.
# Do not put real credentials in this file or any assets/ JavaScript.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Existing Vercel KV integrations can instead provide KV_REST_API_URL / KV_REST_API_TOKEN.
# Optional server-only overrides for the supplied admin account.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt:<48 hex salt>:<128 hex derived key>
